# Auth Platform Configuration
# Copy this to .env and customize

# App
APP_NAME=HTH-CS-02 Auth Platform
APP_VERSION=0.1.0
DEBUG=true
API_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./auth.db
DATABASE_ECHO=false

# Security - CHANGE THESE IN PRODUCTION!
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ENCRYPTION_KEY=your-encryption-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password hashing (Argon2id)
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Rate limiting
RATE_LIMIT_ENABLED=true
REDIS_URL=
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_MFA=5/minute

# TOTP MFA
TOTP_ISSUER=HTH-CS-02
TOTP_WINDOW=1
BACKUP_CODES_COUNT=10
BACKUP_CODE_LENGTH=8

# Risk Engine
RISK_ENABLED=true
RISK_LOW_THRESHOLD=0.3
RISK_MEDIUM_THRESHOLD=0.6
RISK_HIGH_THRESHOLD=0.8

RISK_NEW_DEVICE_WEIGHT=0.7
RISK_NEW_COUNTRY_WEIGHT=0.4
RISK_NEW_CITY_WEIGHT=0.2
RISK_VPN_PROXY_WEIGHT=0.5
RISK_IMPOSSIBLE_TRAVEL_WEIGHT=0.8
RISK_UNUSUAL_HOUR_WEIGHT=0.3
RISK_UNUSUAL_DAY_WEIGHT=0.2
RISK_VELOCITY_WEIGHT=0.5
RISK_FAILED_STREAK_WEIGHT=0.6

# Geo IP
GEO_IP_API_URL=https://ipapi.co
GEO_IP_CACHE_TTL=86400

# Email (disabled for demo)
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@auth-platform.local

# Frontend
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Session cookies
SESSION_COOKIE_NAME=session_id
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax